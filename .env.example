# Frontend build-time configuration.
#
# Copy to `.env.local` for local development (setup.ps1 does this for you), and
# set VITE_API_URL in your CI / hosting environment for production builds.
#
# IMPORTANT: Vite inlines these at BUILD time, not run time. A production build
# made without VITE_API_URL bakes in the http://localhost:8000 fallback from
# src/lib/api.ts and will fail for every visitor — so `vite build` now refuses
# to run unless this is set.

# Base URL of the FastAPI backend, with no trailing slash.
#   local dev  : http://localhost:8000
#   production : https://api.your-domain.com
VITE_API_URL=http://localhost:8000
